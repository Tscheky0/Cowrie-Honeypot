[Unit]
Description=Vorgetaeuschte Active Directory Ports
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/portfake/portfake.py --log /var/log/portfake/portfake.json
Restart=always
RestartSec=5
DynamicUser=yes
LogsDirectory=portfake
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
